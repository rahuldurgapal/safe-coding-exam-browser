{
  "name": "coding-exam-safe-browser",
  "version": "1.0.0",
  "description": "Cross-Platform Secure Kiosk Browser for Online Coding Assessments (Windows, macOS, Linux)",
  "main": "main.js",
  "author": {
    "name": "Rahul Durgapal",
    "email": "rahuldurgapal191@gmail.com"
  },
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --linux --win"
  },
  "build": {
    "appId": "com.codingexam.safebrowser",
    "productName": "CodingExamSafeBrowser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableArgs": [
        "--no-sandbox"
      ],
      "icon": "assets/icon.png",
      "maintainer": "rahuldurgapal191@gmail.com",
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
